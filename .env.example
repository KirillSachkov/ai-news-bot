# Telegram
TELEGRAM_BOT_TOKEN=

# DeepSeek (optional). Without it the bot still works using the heuristic scorer.
# Get a key at platform.deepseek.com — new accounts get a free token grant.
DEEPSEEK_API_KEY=
# Optional overrides:
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# GitHub (optional, needed on servers). The github_rising source searches new
# repositories; from a server GitHub answers anonymous requests with 403.
# Fine-grained token, "Public repositories" read-only, no other permissions.
# GITHUB_TOKEN=
